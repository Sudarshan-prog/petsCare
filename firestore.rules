rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // ============================================================
    // USERS COLLECTION
    // ============================================================
    match /users/{userId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && isOwner(userId);

      allow update: if isAuthenticated()
        && isOwner(userId)
        && request.resource.data.diff(resource.data)
           .affectedKeys()
           .hasOnly(['name', 'phoneNumber', 'latitude', 'longitude',
                     'profileUrl', 'fcmToken', 'lastTokenUpdate', 'role']);

      allow delete: if false;
    }

    // ============================================================
    // CARETAKERS COLLECTION
    // ============================================================
    match /caretakers/{caretakerId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && isOwner(caretakerId);

      allow update: if isAuthenticated()
        && isOwner(caretakerId)
        && request.resource.data.diff(resource.data)
           .affectedKeys()
           .hasOnly(['name', 'bio', 'specialties', 'price',
                     'phoneNumber', 'latitude', 'longitude',
                     'profileUrl', 'serviceFees', 'isAvailable']);

      allow delete: if false;
    }

    // ============================================================
    // BOOKINGS COLLECTION
    // Secure hybrid: Cloud Functions OR authenticated client
    // Client can create bookings (ownerId must match auth)
    // Client can update status (must be owner or caretaker)
    // Cloud Functions bypass these rules via Admin SDK
    // ============================================================
    match /bookings/{bookingId} {
      // Read: Must be owner or caretaker of the booking
      allow read: if isAuthenticated()
        && (isOwner(resource.data.ownerId)
            || isOwner(resource.data.caretakerId));

      // Create: Authenticated user, ownerId must match auth.uid
      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'pending';

      // Update: Must be owner or caretaker, restricted fields
      allow update: if isAuthenticated()
        && (isOwner(resource.data.ownerId)
            || isOwner(resource.data.caretakerId))
        && request.resource.data.diff(resource.data)
           .affectedKeys()
           .hasOnly(['status', 'paymentStatus', 'statusImageUrl',
                     'isRated']);

      allow delete: if false;
    }

    // ============================================================
    // PETS COLLECTION
    // ============================================================
    match /pets/{petId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if isAuthenticated()
        && resource.data.ownerId == request.auth.uid;

      allow delete: if isAuthenticated()
        && resource.data.ownerId == request.auth.uid;
    }
  }
}
