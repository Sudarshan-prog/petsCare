rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // ============================================================
    // USERS COLLECTION
    // Only the user can read/write their own document.
    // Restricted field updates prevent client from modifying
    // fields that should only be set by Cloud Functions.
    // ============================================================
    match /users/{userId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && isOwner(userId);

      allow update: if isAuthenticated()
        && isOwner(userId)
        && request.resource.data.diff(resource.data)
           .affectedKeys()
           .hasOnly(['name', 'phoneNumber', 'latitude', 'longitude',
                     'profileUrl', 'fcmToken', 'lastTokenUpdate', 'role']);

      allow delete: if false; // Only via deleteAccount Cloud Function
    }

    // ============================================================
    // CARETAKERS COLLECTION
    // Anyone auth'd can read (for discovery).
    // Only the caretaker can update their own profile fields.
    // Rating + reviewCount + isVerified: ONLY via Cloud Functions.
    // ============================================================
    match /caretakers/{caretakerId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && isOwner(caretakerId);

      allow update: if isAuthenticated()
        && isOwner(caretakerId)
        && request.resource.data.diff(resource.data)
           .affectedKeys()
           .hasOnly(['name', 'bio', 'specialties', 'price',
                     'phoneNumber', 'latitude', 'longitude',
                     'profileUrl', 'serviceFees', 'isAvailable']);
      // rating, reviewCount, isVerified: ONLY via Cloud Functions

      allow delete: if false; // Only via deleteAccount Cloud Function
    }

    // ============================================================
    // BOOKINGS COLLECTION
    // Created ONLY by createBooking Cloud Function.
    // Updated ONLY by updateBookingStatus Cloud Function.
    // Read by owner or caretaker involved in the booking.
    //
    // EXCEPTION: statusImageUrl can be updated by the caretaker
    // (for live photo updates during a confirmed booking).
    // ============================================================
    match /bookings/{bookingId} {
      allow read: if isAuthenticated()
        && (isOwner(resource.data.ownerId)
            || isOwner(resource.data.caretakerId));

      allow create: if false; // Only via createBooking Cloud Function

      // Allow caretaker to update ONLY statusImageUrl (live photo feature)
      allow update: if isAuthenticated()
        && isOwner(resource.data.caretakerId)
        && resource.data.status == 'confirmed'
        && request.resource.data.diff(resource.data)
           .affectedKeys()
           .hasOnly(['statusImageUrl']);

      allow delete: if false; // Never directly deleted
    }

    // ============================================================
    // PETS COLLECTION
    // Owner manages their own pets.
    // ============================================================
    match /pets/{petId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if isAuthenticated()
        && resource.data.ownerId == request.auth.uid;

      allow delete: if isAuthenticated()
        && resource.data.ownerId == request.auth.uid;
    }
  }
}
